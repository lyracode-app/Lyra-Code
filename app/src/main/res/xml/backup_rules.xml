<full-backup-content>
    <exclude domain="sharedpref" path="first_use_consent.xml" />
    <!-- Debian can be several GB and is managed through its own future export flow. -->
    <exclude domain="file" path="debian-runtime/" />
    <exclude domain="file" path="proot-linux/" />
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>
